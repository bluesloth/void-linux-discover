+/*
+ *   SPDX-FileCopyrightText: 2026 Void Linux
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "XbpsUpdater.h"
+#include "XbpsBackend.h"
+#include <KLocalizedString>
+
+XbpsUpdater::XbpsUpdater(XbpsBackend *parent)
+    : StandardBackendUpdater(parent)
+    , m_backend(parent)
+{
+}
+
+void XbpsUpdater::prepare()
+{
+    setStatus(Status::Done);
+    setProceeding(false);
+}
+
+void XbpsUpdater::proceed()
+{
+    if (m_process && m_process->state() == QProcess::Running) {
+        return;
+    }
+    m_process = new QProcess(this);
+    connect(m_process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished), this, &XbpsUpdater::processFinished);
+    connect(m_process, &QProcess::readyReadStandardOutput, this, &XbpsUpdater::processOutput);
+    connect(m_process, &QProcess::readyReadStandardError, this, &XbpsUpdater::processOutput);
+    
+    setStatus(Status::Proceeding);
+    m_process->setProgram(QStringLiteral("pkexec"));
+    m_process->setArguments({QStringLiteral("xbps-install") << QStringLiteral("-y") << QStringLiteral("-u")});
+    // Better: sync first? The handoff says pkexec -S for refresh; keep simple
+    m_process->setArguments({QStringLiteral("xbps-install"), QStringLiteral("-y"), QStringLiteral("-u")});
+    // Use pkexec
+    m_process->setProgram(QStringLiteral("pkexec"));
+    m_process->setArguments({QStringLiteral("xbps-install"), QStringLiteral("-y"), QStringLiteral("-u")});
+    m_process->start();
+}
+
+void XbpsUpdater::cancel()
+{
+    if (m_process && m_process->state() == QProcess::Running) {
+        m_process->kill();
+    }
+    setStatus(Status::Cancelled);
+}
+
+bool XbpsUpdater::hasUpdates() const
+{
+    return m_updatesCount > 0;
+}
+
+void XbpsUpdater::processOutput()
+{
+    if (!m_process) return;
+    QByteArray out = m_process->readAllStandardOutput();
+    if (!out.isEmpty()) {
+        QString msg = QString::fromUtf8(out).trimmed();
+        if (!msg.isEmpty()) setMessage(msg);
+    }
+}
+
+void XbpsUpdater::processFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    if (exitStatus == QProcess::NormalExit && exitCode == 0) {
+        setStatus(Status::Done);
+        m_updatesCount = 0;
+        Q_EMIT updatesCountChanged();
+    } else {
+        setStatus(Status::Error);
+    }
+}
+
+#include "XbpsUpdater.moc"
+
