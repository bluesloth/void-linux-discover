+/*
+ *   SPDX-FileCopyrightText: 2026 Void Linux
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "XbpsTransaction.h"
+#include "XbpsResource.h"
+#include <KLocalizedString>
+#include <QDebug>
+
+XbpsTransaction::XbpsTransaction(XbpsResource *app, Role role)
+    : Transaction(app, app, role, QString())
+    , m_process(new QProcess(this))
+{
+    setStatus(SetupStatus);
+    setCancellable(true);
+
+    QString prog;
+    QStringList args;
+
+    if (role == InstallRole) {
+        m_actionText = i18nc("@info Status information, widget title", "Installing");
+        prog = QStringLiteral("pkexec");
+        args << QStringLiteral("xbps-install") << QStringLiteral("-y") << QStringLiteral("--") << app->packageName();
+    } else if (role == RemoveRole) {
+        m_actionText = i18nc("@info Status information, widget title", "Removing");
+        prog = QStringLiteral("pkexec");
+        args << QStringLiteral("xbps-remove") << QStringLiteral("-y") << QStringLiteral("--") << app->packageName();
+    } else {
+        prog = QStringLiteral("xbps-install");
+        args << QStringLiteral("-nSu");
+    }
+
+    setStatus(DownloadingStatus);
+
+    connect(m_process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished), this, &XbpsTransaction::processFinished);
+    connect(m_process, &QProcess::errorOccurred, this, &XbpsTransaction::processError);
+    connect(m_process, &QProcess::readyReadStandardOutput, this, &XbpsTransaction::processOutput);
+    connect(m_process, &QProcess::readyReadStandardError, this, &XbpsTransaction::processOutput);
+
+    m_process->setProgram(prog);
+    m_process->setArguments(args);
+    m_process->start();
+}
+
+XbpsTransaction::~XbpsTransaction()
+{
+    if (m_process && m_process->state() == QProcess::Running) {
+        m_process->kill();
+    }
+}
+
+void XbpsTransaction::cancel()
+{
+    if (m_process && m_process->state() == QProcess::Running) {
+        m_process->kill();
+        setStatus(CancelledStatus);
+    }
+}
+
+void XbpsTransaction::processOutput()
+{
+    if (!m_process) return;
+    QByteArray out = m_process->readAllStandardOutput();
+    if (!out.isEmpty()) {
+        QString msg = QString::fromUtf8(out).trimmed();
+        if (!msg.isEmpty()) {
+            setProgressText(msg);
+        }
+    }
+    QByteArray err = m_process->readAllStandardError();
+    if (!err.isEmpty()) {
+        QString msg = QString::fromUtf8(err).trimmed();
+        if (!msg.isEmpty()) {
+            setProgressText(msg);
+        }
+    }
+}
+
+void XbpsTransaction::processFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    if (exitStatus != QProcess::NormalExit || exitCode != 0) {
+        setStatus(DoneWithErrorStatus);
+        return;
+    }
+    setStatus(DoneStatus);
+}
+
+void XbpsTransaction::processError(QProcess::ProcessError error)
+{
+    qWarning() << "XbpsTransaction error:" << error;
+    setStatus(DoneWithErrorStatus);
+}
+
+#include "XbpsTransaction.moc"
+
