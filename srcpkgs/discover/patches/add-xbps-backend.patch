+
+DISCOVER_BACKEND_PLUGIN(XbpsBackend)
+
+XbpsBackend::XbpsBackend(QObject *parent)
+    : AbstractResourcesBackend(parent)
+    , m_updater(new XbpsUpdater(this))
+    , m_reviews(nullptr)
+    , m_updatesTimer(new QTimer(this))
+{
+    connect(m_updater, &XbpsUpdater::updatesCountChanged, this, &XbpsBackend::updatesCountChanged);
+    connect(TransactionModel::global(), &TransactionModel::lastTransactionFinished, this, &XbpsBackend::checkForUpdates);
+    
+    SourcesModel::global()->addSourcesBackend(new XbpsSourcesBackend(this));
+    
+    m_updatesTimer->setSingleShot(true);
+    connect(m_updatesTimer, &QTimer::timeout, this, &XbpsBackend::refreshUpdates);
+    
+    QTimer::singleShot(0, this, &XbpsBackend::refreshInstalled);
+    QTimer::singleShot(100, this, &XbpsBackend::checkForUpdates);
+}
+
+XbpsBackend::~XbpsBackend() = default;
+
+XbpsResource *XbpsBackend::resourceByPackageName(const QString &name) const
+{
+    return m_resources.value(name);
+}
+
+void XbpsBackend::addResource(XbpsResource *res)
+{
+    res->setParent(this);
+    m_resources[res->packageName()] = res;
+}
+
+void XbpsBackend::refreshInstalled()
+{
+    loadInstalled();
+}
+
+void XbpsBackend::refreshUpdates()
+{
+    loadUpdates();
+}
+
+void XbpsBackend::loadInstalled()
+{
+    QProcess proc;
+    proc.start(QStringLiteral("xbps-query"), {QStringLiteral("-l")});
+    proc.waitForFinished(10000);
+    QByteArray out = proc.readAllStandardOutput();
+    
+    for (const QByteArray &line : out.split('\n')) {
+        if (line.isEmpty()) continue;
+        // Format: ii package-version_1 description
+        if (line.size() < 3) continue;
+        QString s = QString::fromUtf8(line);
+        if (!s.startsWith(QStringLiteral("ii ")) && !s.startsWith(QStringLiteral("uu "))) continue;
+        QString rest = s.mid(3);
+        int space = rest.indexOf(QLatin1Char(' '));
+        if (space < 0) continue;
+        QString pkgver = rest.left(space);
+        QString desc = rest.mid(space + 1).trimmed();
+        // strip leading spaces/tabs
+        while (!desc.isEmpty() && (desc.at(0).isSpace() || desc.at(0) == QLatin1Char('\t'))) desc.remove(0, 1);
+        // extract package name
+        int dash = pkgver.lastIndexOf(QLatin1Char('-'));
+        while (dash > 0 && pkgver[dash - 1].isDigit()) {
+            dash = pkgver.lastIndexOf(QLatin1Char('-'), dash - 1);
+        }
+        // find first '-' followed by digit from right in version part? easier: split on last '-' before version
+        // xbps-query -l shows pkgver as name-version_revision; name has no '-' before version usually
+        // try to find pattern -digits
+        QRegularExpression re(QStringLiteral("^(.*)-([0-9].*)$"));
+        QRegularExpressionMatch m = re.match(pkgver);
+        QString pkgname = m.hasMatch() ? m.captured(1) : pkgver;
+        if (m_resources.contains(pkgname)) continue;
+        XbpsResource *res = new XbpsResource(pkgname, pkgver, desc, this, AbstractResource::Installed);
+        addResource(res);
+    }
+    Q_EMIT contentsChanged();
+}
+
+void XbpsBackend::loadUpdates()
+{
+    QProcess proc;
+    proc.start(QStringLiteral("xbps-install"), {QStringLiteral("-nSu")});
+    proc.waitForFinished(30000);
+    QByteArray out = proc.readAllStandardOutput();
+    int count = 0;
+    for (const QByteArray &line : out.split('\n')) {
+        if (line.isEmpty()) continue;
+        if (line.contains("update")) count++;
+    }
+    m_updater->setUpdatesCount(count);
+}
+
+ResultsStream *XbpsBackend::search(const AbstractResourcesBackend::Filters &filter)
+{
+    ResultsStream *stream = new ResultsStream(QStringLiteral("XbpsSearch"));
+    if (filter.search.isEmpty()) {
+        QTimer::singleShot(0, stream, &ResultsStream::finish);
+        return stream;
+    }
+    
+    QProcess *proc = new QProcess(stream);
+    proc->setProgram(QStringLiteral("xbps-query"));
+    proc->setArguments({QStringLiteral("-Rs"), filter.search});
+    connect(proc, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished), stream, [this, stream, proc](int, QProcess::ExitStatus) {
+        QByteArray out = proc->readAllStandardOutput();
+        QVector<StreamResult> results;
+        for (const QByteArray &line : out.split('\n')) {
+            if (line.isEmpty()) continue;
+            QString s = QString::fromUtf8(line);
+            if (s.startsWith(QStringLiteral("[-]")) || s.startsWith(QStringLiteral("[*]"))) {
+                QString rest = s.mid(4).trimmed();
+                int space = rest.indexOf(QLatin1Char(' '));
+                if (space < 0) continue;
+                QString pkgver = rest.left(space).trimmed();
+                QString desc = rest.mid(space + 1).trimmed();
+                while (!desc.isEmpty() && desc.at(0).isSpace()) desc.remove(0, 1);
+                QRegularExpression re(QStringLiteral("^(.*)-([0-9].*)$"));
+                QRegularExpressionMatch m = re.match(pkgver);
+                QString pkgname = m.hasMatch() ? m.captured(1) : pkgver;
+                if (!m_resources.contains(pkgname)) {
+                    XbpsResource *res = new XbpsResource(pkgname, pkgver, desc, this, AbstractResource::None);
+                    m_resources[pkgname] = res;
+                }
+                results << StreamResult(m_resources[pkgname]);
+            }
+        }
+        Q_EMIT stream->resourcesFound(results);
+        stream->finish();
+        proc->deleteLater();
+    });
+    proc->start();
+    return stream;
+}
+
+Transaction *XbpsBackend::installApplication(AbstractResource *app)
+{
+    return installApplication(app, AddonList());
+}
+
+Transaction *XbpsBackend::installApplication(AbstractResource *app, const AddonList &)
+{
+    return new XbpsTransaction(qobject_cast<XbpsResource *>(app), Transaction::InstallRole);
+}
+
+Transaction *XbpsBackend::removeApplication(AbstractResource *app)
+{
+    return new XbpsTransaction(qobject_cast<XbpsResource *>(app), Transaction::RemoveRole);
+}
+
+int XbpsBackend::fetchingUpdatesProgress() const
+{
+    return m_fetching ? 0 : 100;
+}
+
+void XbpsBackend::checkForUpdates()
+{
+    m_updatesTimer->start(0);
+}
+
+QString XbpsBackend::displayName() const
+{
+    return i18nc("Backend plugin display name", "xbps");
+}
+
+bool XbpsBackend::hasApplications() const
+{
+    return true;
+}
+
+#include "XbpsBackend.moc"
