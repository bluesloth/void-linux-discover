+    // [CUSTOM-FLATPAK-USER-SCOPE] Official/installer-provided remotes stay
+    // system-wide. A local .flatpakrepo chosen by the user is untrusted input
+    // (its URL and GPG key become root-installed), so route it to the user
+    // installation -- the same boundary COSMIC Store uses.
+    FlatpakInstallation *sourceInstallation = preferredInstallation();
+    const QString repoHost = QUrl(repoUrl).host();
+    if (repoHost != QLatin1String("flathub.org") &&
+        repoHost != QLatin1String("dl.flathub.org") &&
+        repoHost != QLatin1String("cosmic")) {
+        for (FlatpakInstallation *candidate : std::as_const(m_installations)) {
+            if (flatpak_installation_get_is_user(candidate)) {
+                sourceInstallation = candidate;
+                break;
+            }
+        }
+    }
+
