configure_args="-DBUILD_XbpsBackend=ON"

# The xbps backend is carried as a set of source files under files/xbps/ rather
# than as a patch, so that a discover release bump does not invalidate the
# diff context of a unified patch against upstream CMakeLists.txt.
post_extract() {
	local backend_dir=${wrksrc}/libdiscover/backends/XbpsBackend
	mkdir -p "$backend_dir"
	cp ${FILESDIR}/xbps/* "$backend_dir"/

	# Wire the backend into the list of backends.
	grep -q "add_subdirectory(XbpsBackend)" ${wrksrc}/libdiscover/backends/CMakeLists.txt || {
		cat >> ${wrksrc}/libdiscover/backends/CMakeLists.txt <<-EOF

		option(BUILD_XbpsBackend "Build xbps support." "ON")
		if(BUILD_XbpsBackend)
		    add_subdirectory(XbpsBackend)
		endif()
		EOF
	}
}

# The polkit actions of the backend are not part of the upstream source tree,
# so they are installed separately after the regular installation.
post_install() {
	install -Dm644 ${FILESDIR}/org.kde.discover.xbps.policy \
		${DESTDIR}/usr/share/polkit-1/actions/org.kde.discover.xbps.policy
}
