depends="AppStream AppStream-qt kf6-kitemmodels kf6-attica kf6-kconfig kf6-kcoreaddons kf6-kcrash kf6-kdbusaddons kf6-ki18n kf6-kiconthemes kf6-kidletime kf6-kjobwidgets kf6-kcmutils kf6-kio kf6-knewstuff kf6-knotifications kf6-kservice kf6-kstatusnotifieritem kf6-kwidgetsaddons kf6-kwindowsystem kf6-kirigami kf6-kxmlgui kf6-purpose kirigami-addons qcoro-qt6 qt6-base qt6-declarative qt6-webview flatpak fwupd glib polkit"
